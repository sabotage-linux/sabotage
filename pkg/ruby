[mirrors]
https://cache.ruby-lang.org/pub/ruby/2.7/ruby-2.7.8.tar.xz

[vars]
filesize=12105320
sha512=4b49dff3e1c2e79d914e10418e4c03026f5d4c137dc337f5c720fe26cb9fcdcf4afc6b7c967356cf5fbe04cc5ef431174c48a035becf3e2322c2c45d3c9b2f59
pkgver=7
desc='interpreter for the ruby scripting language'

[deps]
zlib
libressl
gdbm
gmp

[build]
patch -p0 < "$K"/ruby-libressl.patch
# thx alpine for patches
patch -p1 < "$K"/ruby-rubygems-avoid-platform-specific-gems.patch
patch -p1 < "$K"/ruby-test_insns-lower-recursion-depth.patch
patch -p1 < "$K"/ruby-2.7.0-require-symlink.patch

[ -n "$CROSS_COMPILE" ] && \
  xconfflags="--host=$($CC -dumpmachine) \
  --with-sysroot=$butch_root_dir --with-baseruby=ruby"
# ruby crosscompile requires ruby installed on the host!

# -fomit-frame-pointer makes ruby segfault, see gentoo bug #150413
# In many places aliasing rules are broken; play it safe
# as it's risky with newer compilers to leave it as it is.
export CPPFLAGS="-D_GNU_SOURCE -fno-omit-frame-pointer -fno-strict-aliasing"
export CFLAGS="$optcflags -fno-omit-frame-pointer -fno-strict-aliasing"
#export LDFLAGS="$optldflags"

# the configure script does not detect isnan/isinf as macros
export ac_cv_func_isnan=yes
export ac_cv_func_isinf=yes

./configure -C $xconfflags \
  stack_protector=no \
  --without-jemalloc \
  --enable-pthread \
  --enable-shared \
  --disable-rpath \
  --with-mantype=man \
  --prefix="$butch_prefix" \
  rb_cv_binary_elf=yes \
  --disable-load-relative \
  --disable-install-doc

 # the elf test is broken, it uses cat -e which is gnu only

make -j$MAKE_THREADS V=1
make DESTDIR="$butch_install_dir" install
