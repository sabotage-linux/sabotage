[vars]
filesize=9218827
sha512=327ffa6da73f7a1b74d1bc374239ac087ee76672da590626da3a068f972684b0963c50641718c39a7fb2429a56c1076bdfd67e8f7f0eab0eda90b70cf846bbbd

[mirrors]
http://abisource.org/downloads/abiword/2.8.6/source/abiword-2.8.6.tar.gz

[deps]
librsvg
goffice
fribidi
glib
wv

[build]
patch -p1 < "$K"/abiword-png15.patch
patch -p1 < "$K"/abiword-TRUE.patch

[ -n "$CROSS_COMPILE" ] && xconfflags="--host=$($CC -dumpmachine)"
cp -f "$K"/config.sub .
# fix bashism causing library misdetection and link failures
sed -i '/^dnl/!s/\(test "[^"]*"\) == /\1 = /g' configure configure.in
# and a flag for libtool that requires only ONE dash
sed -i 's/--no-undefined/-no-undefined/' src/Makefile.in

CFLAGS="-D_GNU_SOURCE $optcflags" \
CXXFLAGS="$optcflags -std=gnu++03 -Wno-parentheses" \
LDFLAGS="$optldflags -Wl,-rpath-link=$butch_root_dir$butch_prefix/lib" \
  ./configure -C --prefix="$butch_prefix" $xconfflags \
   --disable-static \
   --disable-default-plugins
[ -n "$CROSS_COMPILE" ] && "$K"/libtool.cross.gen --sysroot="$butch_root_dir"
make -j$MAKE_THREADS
make DESTDIR="$butch_install_dir" install
